[Unit]
Description=Take a screenshot of the current display
After=graphical-session.target

[Service]
Type=oneshot
# Adjust DISPLAY/XAUTHORITY if your X session uses non-default values.
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/bin/percy-screenshot.sh

# --- Sandboxing ---
# Only local X11 (unix socket) and file writes under $HOME are needed.
# ProtectHome is explicitly left off (not "read-only"/"tmpfs") since the
# script writes screenshots under $HOME. ProtectProc=invisible still allows
# seeing same-user processes, which lock detection (pgrep) relies on.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
UMask=0077
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
