[Unit]
Description=Run percy-screenshot.service every minute

[Timer]
# OnCalendar (absolute) is used instead of OnBootSec/OnUnitActiveSec, which
# can fail to reschedule after the timer is restarted/reinstalled.
OnCalendar=*:0/1
AccuracySec=1s
Persistent=true
Unit=percy-screenshot.service

[Install]
WantedBy=timers.target
